<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - 页面未找到</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <nav class="navbar scrolled" id="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-logo">Portfolio</a>
      <ul class="nav-menu" id="navMenu">
        <li><a href="/" class="nav-link">首页</a></li>
      </ul>
    </div>
  </nav>

  <main class="not-found" style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:120px 24px 60px;">
    <div class="container" data-aos="fade-up" data-aos-duration="600">
      <div style="font-size:8rem;font-weight:900;line-height:1;background:linear-gradient(135deg,#3b82f6,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:16px;">404</div>
      <h1 style="font-size:1.8rem;font-weight:700;margin-bottom:12px;">页面未找到</h1>
      <p style="color:var(--text-secondary,#475569);font-size:1.05rem;margin-bottom:36px;max-width:500px;margin-left:auto;margin-right:auto;">您访问的页面不存在，可能已被移动或删除。</p>
      <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> 返回首页</a>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 Portfolio. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>
