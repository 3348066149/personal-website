<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>修改密码 - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <h2><i class="fas fa-cog"></i> 管理后台</h2>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/projects"><i class="fas fa-folder"></i> 项目管理</a>
        <a href="/admin/config"><i class="fas fa-sliders-h"></i> 网站配置</a>
        <a href="/admin/change-password" class="active"><i class="fas fa-key"></i> 修改密码</a>
      </nav>
      <div class="sidebar-user">
        <div class="sidebar-user-avatar">
          <img src="<%= config.avatar_url || '/images/avatar.jpg' %>" alt="" onerror="this.style.display='none'">
        </div>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name">admin</div>
          <div class="sidebar-user-role">管理员</div>
        </div>
        <a href="/admin/logout" class="sidebar-logout-btn" title="退出登录"><i class="fas fa-sign-out-alt"></i></a>
      </div>
    </aside>

    <main class="admin-main">
      <div class="admin-header">
        <h1><i class="fas fa-key"></i> 修改密码</h1>
      </div>

      <% if (locals.message) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= message %></div>
      <% } %>

      <div class="config-card" style="max-width:500px">
        <form method="POST" action="/admin/change-password">
          <div class="form-group">
            <label>当前密码</label>
            <input type="password" name="current_password" required>
          </div>
          <div class="form-group">
            <label>新密码</label>
            <input type="password" name="new_password" required>
          </div>
          <div class="form-group">
            <label>确认新密码</label>
            <input type="password" name="confirm_password" required>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> 修改密码</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(el => el.style.opacity = '0');
    }, 3000);
  </script>
</body>
</html>
