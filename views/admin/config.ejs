<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>网站配置 - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <h2><i class="fas fa-cog"></i> 管理后台</h2>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin/projects"><i class="fas fa-folder"></i> 项目管理</a>
        <a href="/admin/config" class="active"><i class="fas fa-sliders-h"></i> 网站配置</a>
        <a href="/admin/change-password"><i class="fas fa-key"></i> 修改密码</a>
      </nav>
      <div class="sidebar-user">
        <div class="sidebar-user-avatar">
          <img src="<%= config.avatar_url || '/images/avatar.jpg' %>" alt="" onerror="this.style.display='none'">
        </div>
        <div class="sidebar-user-info">
          <div class="sidebar-user-name">admin</div>
          <div class="sidebar-user-role">管理员</div>
        </div>
        <a href="/admin/logout" class="sidebar-logout-btn" title="退出登录"><i class="fas fa-sign-out-alt"></i></a>
      </div>
    </aside>

    <main class="admin-main">
      <div class="admin-header">
        <h1><i class="fas fa-sliders-h"></i> 网站配置</h1>
      </div>

      <% if (locals.message) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= message %></div>
      <% } %>

      <div class="config-card">
        <form method="POST" action="/admin/config" enctype="multipart/form-data">
          <div class="form-group">
            <label>网站标题（Hero 主标题）</label>
            <input type="text" name="hero_title" value="<%= config.hero_title || '' %>">
          </div>
          <div class="form-group">
            <label>副标题</label>
            <textarea name="hero_subtitle" rows="2"><%= config.hero_subtitle || '' %></textarea>
          </div>
          <div class="form-group">
            <label>头像</label>
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
              <img src="<%= config.avatar_url || '/images/avatar.jpg' %>" alt="" style="width:56px;height:56px;border-radius:14px;object-fit:cover;background:#f1f5f9" onerror="this.style.display='none'">
              <div>
                <div class="form-hint" style="margin-top:0">当前头像，上传新图片会自动替换</div>
              </div>
            </div>
            <input type="file" name="avatar_file" accept="image/*">
          </div>
          <div class="form-group" style="display:none">
            <label>头像 URL</label>
            <input type="text" name="avatar_url" value="<%= config.avatar_url || '' %>">
          </div>
          <div class="form-group">
            <label>邮箱</label>
            <input type="email" name="email" value="<%= config.email || '' %>">
          </div>
          <div class="form-group">
            <label>GitHub URL</label>
            <input type="url" name="github_url" value="<%= config.github_url || '' %>">
          </div>
          <div class="form-group">
            <label>LinkedIn URL</label>
            <input type="url" name="linkedin_url" value="<%= config.linkedin_url || '' %>">
          </div>
          <div class="form-group">
            <label>微信二维码图片</label>
            <% if (config.wechat_image_url) { %>
              <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
                <img src="<%= config.wechat_image_url %>" alt="" style="width:80px;height:80px;border-radius:8px;object-fit:cover;background:#f1f5f9" onerror="this.style.display='none'">
                <div>
                  <div class="form-hint" style="margin-top:0">当前微信二维码</div>
                </div>
              </div>
            <% } %>
            <input type="file" name="wechat_image_file" accept="image/*">
          </div>
          <div class="form-group">
            <label>微信提示文字（显示在二维码下方）</label>
            <input type="text" name="wechat_text" value="<%= config.wechat_text || '有兴趣加我V' %>">
          </div>
          <div class="form-group">
            <label>哔哩哔哩 URL</label>
            <input type="url" name="bilibili_url" value="<%= config.bilibili_url || '' %>">
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> 保存配置</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    // Upload progress for config form
    document.querySelector('.config-card form').addEventListener('submit', function(e) {
      // Only show progress if files are being uploaded
      var hasFile = false;
      this.querySelectorAll('input[type=\"file\"]').forEach(function(el) { if (el.files.length > 0) hasFile = true; });
      if (!hasFile) return;

      e.preventDefault();
      var formData = new FormData(this);
      var xhr = new XMLHttpRequest();

      var overlay = document.createElement('div');
      overlay.className = 'upload-overlay';
      overlay.innerHTML = '<div class=\"upload-modal\"><div class=\"upload-icon\" id=\"uploadIcon\"><i class=\"fas fa-cloud-upload-alt\"></i></div><div class=\"upload-progress-bar\"><div class=\"upload-progress-fill\" id=\"progressFill\"></div></div><div class=\"upload-progress-text\" id=\"progressText\">正在上传 0%</div></div>';
      document.body.appendChild(overlay);

      var progressFill = document.getElementById('progressFill');
      var progressText = document.getElementById('progressText');
      var uploadIcon = document.getElementById('uploadIcon');

      xhr.upload.addEventListener('progress', function(e) {
        if (e.lengthComputable) {
          var pct = Math.round((e.loaded / e.total) * 100);
          progressFill.style.width = pct + '%';
          progressText.textContent = '正在上传 ' + pct + '%';
        }
      });

      xhr.addEventListener('load', function() {
        if (xhr.status >= 200 && xhr.status < 300) {
          progressFill.style.width = '100%';
          progressText.textContent = '上传完成';
          uploadIcon.innerHTML = '<i class=\"fas fa-check-circle\" style=\"color:#22c55e\"></i>';
          overlay.querySelector('.upload-modal').classList.add('success');
          setTimeout(function() { overlay.remove(); window.location.href = xhr.responseURL; }, 800);
        } else {
          uploadIcon.innerHTML = '<i class=\"fas fa-times-circle\" style=\"color:#ef4444\"></i>';
          progressText.textContent = '上传失败';
          overlay.querySelector('.upload-modal').classList.add('error');
          setTimeout(function() { overlay.remove(); }, 1500);
        }
      });

      xhr.addEventListener('error', function() {
        uploadIcon.innerHTML = '<i class=\"fas fa-times-circle\" style=\"color:#ef4444\"></i>';
        progressText.textContent = '网络错误';
        setTimeout(function() { overlay.remove(); }, 1500);
      });

      xhr.open('POST', '/admin/config', true);
      xhr.send(formData);
    });
  </script>
</body>
</html>
